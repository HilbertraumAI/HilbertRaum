{
  // Renderer (browser context) + the test suite (renderer tests use jsdom/RTL; service
  // tests import main code, which type-checks fine here too). DOM lib is available.
  // ES2024: see tsconfig.node.json. Until streamdown 2.6 this program also got `esnext` by
  // accident (streamdown → mermaid → type-fest's `/// <reference lib="esnext"/>`), which hid an
  // ES2024 API in three tests (#550); `tsc --explainFiles` shows which libs actually load.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx"
  },
  "include": ["src/renderer", "tests"]
}
