{
  "contract": "The reading of updates/last-result.txt for the commit's cleared line (app-update task T6.0b; record docs/app-updates.md 4.5 \"The cleared line\", 5.3 \"last-result.txt\", 5.8; F-20's reader half as P6 builds it in updates/last-result.ts). Written from the record before the module existed",
  "how": "`file` is the file's bytes (a bytes spec as cases.json's: {text}, {hex}, {fill, length}, {parts}), or null for no file; `version` is <v>. `expect.lastValid` is the last valid line's first three fields, or null; `expect.marks` says whether the file marks <v> (that line's version equals <v> byte for byte and its code is neither applied nor cleared)",
  "append": {
    "form": "one write of LF, `cleared <v> <token>`, LF, then fsync",
    "token": "16 lower-case hex characters from crypto.randomBytes(8), drawn again while it equals the last valid line's token or the third field of updates/last-result.seen's line",
    "pattern": "^\\ncleared <v> [0-9a-f]{16}\\n$",
    "when": "only when the file marks <v>; a failed append fails the commit with UPD-CANT-WRITE-DRIVE"
  },
  "vectors": [
    {"id":"absent","why":"no file: no mark (the file is given as null)","file":null,"version":"1.1.0","expect":{"lastValid":null,"marks":false}},
    {"id":"empty","why":"an empty file: no valid line","file":{"text":""},"version":"1.1.0","expect":{"lastValid":null,"marks":false}},
    {"id":"fallback-marks","why":"a fallback line of this version marks it","file":{"text":"\nfallback 1.1.0 0123456789abcdef\n"},"version":"1.1.0","expect":{"lastValid":{"code":"fallback","version":"1.1.0","token":"0123456789abcdef"},"marks":true}},
    {"id":"last-line-crlf","why":"T6.0b's golden: the last line ends CR LF (a cmd writer); one CR at a line's end is removed first","file":{"text":"\r\nio-error 1.1.0 0123456789abcdef\r\n"},"version":"1.1.0","expect":{"lastValid":{"code":"io-error","version":"1.1.0","token":"0123456789abcdef"},"marks":true}},
    {"id":"last-line-no-line-end","why":"the last line may end without an LF","file":{"text":"\ntimeout 1.1.0 0123456789abcdef"},"version":"1.1.0","expect":{"lastValid":{"code":"timeout","version":"1.1.0","token":"0123456789abcdef"},"marks":true}},
    {"id":"applied-does-not-mark","why":"applied is the success set: no mark","file":{"text":"\napplied 1.1.0 0123456789abcdef\n"},"version":"1.1.0","expect":{"lastValid":{"code":"applied","version":"1.1.0","token":"0123456789abcdef"},"marks":false}},
    {"id":"cleared-does-not-mark","why":"cleared is the success set: no mark","file":{"text":"\nfallback 1.1.0 0123456789abcdef\n\ncleared 1.1.0 fedcba9876543210\n"},"version":"1.1.0","expect":{"lastValid":{"code":"cleared","version":"1.1.0","token":"fedcba9876543210"},"marks":false}},
    {"id":"other-version","why":"the version equals <v> byte for byte: another version does not mark it","file":{"text":"\nfallback 1.0.5 0123456789abcdef\n"},"version":"1.1.0","expect":{"lastValid":{"code":"fallback","version":"1.0.5","token":"0123456789abcdef"},"marks":false}},
    {"id":"version-other-case","why":"byte for byte: 1.1.0-RC1 does not mark 1.1.0-rc1","file":{"text":"\nfallback 1.1.0-RC1 0123456789abcdef\n"},"version":"1.1.0-rc1","expect":{"lastValid":{"code":"fallback","version":"1.1.0-RC1","token":"0123456789abcdef"},"marks":false}},
    {"id":"helper-blocked-other-computer","why":"a helper-blocked line of another computer marks, its extra fields ignored","file":{"text":"\nhelper-blocked 1.1.0 0123456789abcdef os=darwin boot=1795000000\n"},"version":"1.1.0","expect":{"lastValid":{"code":"helper-blocked","version":"1.1.0","token":"0123456789abcdef"},"marks":true}},
    {"id":"unknown-code-marks","why":"a later writer's code is neither applied nor cleared: it marks","file":{"text":"\nquarantined 1.1.0 0123456789abcdef\n"},"version":"1.1.0","expect":{"lastValid":{"code":"quarantined","version":"1.1.0","token":"0123456789abcdef"},"marks":true}},
    {"id":"last-valid-line-wins","why":"the last valid line wins: a later applied line of the version ends the mark","file":{"text":"\nfallback 1.1.0 0123456789abcdef\n\napplied 1.1.0 fedcba9876543210\n"},"version":"1.1.0","expect":{"lastValid":{"code":"applied","version":"1.1.0","token":"fedcba9876543210"},"marks":false}},
    {"id":"torn-last-line","why":"a line with fewer than three fields is ignored: the line before it is the last valid one","file":{"text":"\nfallback 1.1.0 0123456789abcdef\n\napplied 1.1.0"},"version":"1.1.0","expect":{"lastValid":{"code":"fallback","version":"1.1.0","token":"0123456789abcdef"},"marks":true}},
    {"id":"malformed-code","why":"a code outside [a-z][a-z0-9-]{0,31} is ignored (upper case)","file":{"text":"\nfallback 1.1.0 0123456789abcdef\n\nApplied 1.1.0 fedcba9876543210\n"},"version":"1.1.0","expect":{"lastValid":{"code":"fallback","version":"1.1.0","token":"0123456789abcdef"},"marks":true}},
    {"id":"code-33-bytes","why":"a code of 33 bytes is ignored; one of 32 counts","file":{"text":"\naaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa 1.1.0 0123456789abcdef\n\nbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb 1.1.0 fedcba9876543210\n"},"version":"1.1.0","expect":{"lastValid":{"code":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","version":"1.1.0","token":"0123456789abcdef"},"marks":true}},
    {"id":"version-not-semver","why":"a version that is no SemVer is ignored","file":{"text":"\nfallback 1.1.0 0123456789abcdef\n\napplied 1.1 fedcba9876543210\n"},"version":"1.1.0","expect":{"lastValid":{"code":"fallback","version":"1.1.0","token":"0123456789abcdef"},"marks":true}},
    {"id":"version-65-bytes","why":"a version over 64 bytes is ignored","file":{"text":"\nfallback 1.1.0 0123456789abcdef\n\napplied 1.1.0-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa fedcba9876543210\n"},"version":"1.1.0","expect":{"lastValid":{"code":"fallback","version":"1.1.0","token":"0123456789abcdef"},"marks":true}},
    {"id":"token-65-bytes","why":"a token over 64 bytes is ignored; one of 64 counts","file":{"text":"\nfallback 1.1.0 cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc\n\napplied 1.1.0 ddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd\n"},"version":"1.1.0","expect":{"lastValid":{"code":"fallback","version":"1.1.0","token":"cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"},"marks":true}},
    {"id":"non-ascii-byte","why":"a line holding a byte outside 0x20–0x7E and TAB is ignored","file":{"parts":[{"text":"\nfallback 1.1.0 0123456789abcdef\n\napplied 1.1.0 fedcba98765432"},{"hex":"c3a9"},{"text":"\n"}]},"version":"1.1.0","expect":{"lastValid":{"code":"fallback","version":"1.1.0","token":"0123456789abcdef"},"marks":true}},
    {"id":"nul-byte","why":"a line holding a NUL (a torn tail) is ignored","file":{"parts":[{"text":"\nfallback 1.1.0 0123456789abcdef\n\napplied 1.1.0 fedcba9876543210"},{"hex":"0000"}]},"version":"1.1.0","expect":{"lastValid":{"code":"fallback","version":"1.1.0","token":"0123456789abcdef"},"marks":true}},
    {"id":"cr-inside-line","why":"only one CR at a line's end is removed: a CR inside a line is a byte outside the set","file":{"text":"\nfallback 1.1.0 0123456789abcdef\n\napplied 1.1.0\rfedcba9876543210\n"},"version":"1.1.0","expect":{"lastValid":{"code":"fallback","version":"1.1.0","token":"0123456789abcdef"},"marks":true}},
    {"id":"two-crs-at-end","why":"only one CR is removed: a line ending CR CR LF keeps a CR and is ignored","file":{"text":"\nfallback 1.1.0 0123456789abcdef\n\napplied 1.1.0 fedcba9876543210\r\r\n"},"version":"1.1.0","expect":{"lastValid":{"code":"fallback","version":"1.1.0","token":"0123456789abcdef"},"marks":true}},
    {"id":"tabs-and-spaces","why":"spaces and TABs are trimmed, and fields split at runs of them","file":{"text":"\n \tfallback\t\t1.1.0   0123456789abcdef \t\n"},"version":"1.1.0","expect":{"lastValid":{"code":"fallback","version":"1.1.0","token":"0123456789abcdef"},"marks":true}},
    {"id":"line-1024-bytes","why":"a line of exactly 1,024 bytes (extra fields fill it) counts","file":{"parts":[{"text":"\nfallback 1.1.0 0123456789abcdef\n\napplied 1.1.0 fedcba9876543210 "},{"fill":"78","length":993},{"text":"\n"}]},"version":"1.1.0","expect":{"lastValid":{"code":"applied","version":"1.1.0","token":"fedcba9876543210"},"marks":false}},
    {"id":"line-1025-bytes","why":"a line of 1,025 bytes is ignored","file":{"parts":[{"text":"\nfallback 1.1.0 0123456789abcdef\n\napplied 1.1.0 fedcba9876543210 "},{"fill":"78","length":994},{"text":"\n"}]},"version":"1.1.0","expect":{"lastValid":{"code":"fallback","version":"1.1.0","token":"0123456789abcdef"},"marks":true}},
    {"id":"line-1024-bytes-and-cr","why":"the CR is removed before the length is taken: 1,024 bytes and CR LF counts","file":{"parts":[{"text":"\nfallback 1.1.0 0123456789abcdef\n\napplied 1.1.0 fedcba9876543210 "},{"fill":"78","length":993},{"text":"\r\n"}]},"version":"1.1.0","expect":{"lastValid":{"code":"applied","version":"1.1.0","token":"fedcba9876543210"},"marks":false}},
    {"id":"exactly-65536-bytes","why":"a file of exactly 65,536 bytes is read whole: its first line counts","file":{"parts":[{"text":"io-error 1.1.0 0123456789abcdef\n"},{"fill":"0a","length":65504}]},"version":"1.1.0","expect":{"lastValid":{"code":"io-error","version":"1.1.0","token":"0123456789abcdef"},"marks":true}},
    {"id":"65537-bytes-first-line-cut","why":"a longer file: only its last 65,536 bytes are read, and everything up to and including the first LF in that window is dropped; the window starts one byte into the first line, whose rest (\"o-error …\") would not parse anyway","file":{"parts":[{"text":"io-error 1.1.0 0123456789abcdef\n"},{"fill":"0a","length":65505}]},"version":"1.1.0","expect":{"lastValid":null,"marks":false}},
    {"id":"window-cut-leaves-valid-looking-rest","why":"the window starts 3 bytes into \"io-error 1.1.0 <token>\": the rest, \"error 1.1.0 <token>\", is a valid line by its shape and must still be dropped (the first partial line of a longer file)","file":{"parts":[{"text":"io-error 1.1.0 0123456789abcdef\n"},{"fill":"0a","length":65507}]},"version":"1.1.0","expect":{"lastValid":null,"marks":false}},
    {"id":"window-starts-at-a-line-start","why":"the window starts exactly at a line's first byte: that line is dropped too (everything up to and including the window's first LF)","file":{"parts":[{"text":"x\n"},{"text":"io-error 1.1.0 0123456789abcdef\n"},{"fill":"0a","length":65504}]},"version":"1.1.0","expect":{"lastValid":null,"marks":false}},
    {"id":"window-second-line-kept","why":"a longer file whose marking line lies whole inside the window, after the dropped first line","file":{"parts":[{"fill":"78","length":70000},{"text":"\nio-error 1.1.0 0123456789abcdef\n"}]},"version":"1.1.0","expect":{"lastValid":{"code":"io-error","version":"1.1.0","token":"0123456789abcdef"},"marks":true}}
  ]
}
